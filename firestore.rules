rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function millis() { return request.time.toMillis(); }
    function player(id) { return /databases/$(database)/documents/players/$(id); }
    function clan(id) { return /databases/$(database)/documents/clans/$(id); }
    function tree(id) { return /databases/$(database)/documents/trees/$(id); }
    function duel(id) { return /databases/$(database)/documents/challenges/$(id); }
    function codeRef(code) { return /databases/$(database)/documents/clanCodes/$(code); }
    function me() { return get(player(uid())).data; }
    function nearNow(value) { return value is int && value >= millis() - 60000 && value <= millis() + 60000; }
    function member(id) { return signed() && id is string && me().clanId == id; }
    function guardedByMe(owner) {
      return signed() && (owner == uid() || (me().clanId is string && get(player(owner)).data.clanId == me().clanId));
    }
    function admin() {
      return signed() && exists(/databases/$(database)/documents/admins/$(uid())) && me().pseudo == 'admin-forestrix';
    }
    // Season 1, Oxford GMT. Keep these boundaries and the reserved tree in sync with index.html.
    function seasonStartMillis() { return 1796083200000; }
    function seasonEndMillis() { return 1800921600000; }
    function seasonExpired(acquired) { return acquired < seasonEndMillis() && millis() >= seasonEndMillis(); }
    function weeklyTree() { return '13100408200'; }
    // BEGIN GENERATED PARK CATALOG
    function gameBucket(bucket) { return
      bucket == 0 ? {'8668823424':[51.7605539,-1.2528142,'oxford'],'paris-2000160':[48.8799913,2.2609481,'paris'],'paris-2002352':[48.870952,2.2479907,'paris'],'paris-218720':[48.8555133,2.2261086,'paris'],'paris-234560':[48.8543813,2.2611548,'paris']} :
      bucket == 1 ? {'3102635409':[51.7617136,-1.2509279,'oxford'],'9233082817':[51.7629601,-1.2521357,'oxford'],'paris-2002353':[48.87166,2.250433,'paris'],'paris-203089':[48.8594069,2.2638568,'paris'],'paris-218609':[48.8614497,2.228686,'paris'],'paris-234561':[48.8549791,2.261619,'paris'],'paris-236289':[48.8616285,2.2652386,'paris']} :
      bucket == 2 ? {'paris-2001522':[48.8665078,2.2647129,'paris'],'paris-2002354':[48.8730876,2.2485702,'paris'],'paris-204514':[48.877938,2.2774399,'paris'],'paris-239250':[48.8511925,2.2591864,'paris']} :
      bucket == 3 ? {'13100415507':[51.7602167,-1.2488583,'oxford'],'paris-2000339':[48.8794869,2.2649926,'paris'],'paris-2000787':[48.8796706,2.2581875,'paris'],'paris-2002355':[48.8731236,2.2487684,'paris'],'paris-2002387':[48.8764741,2.2574998,'paris'],'paris-203859':[48.8783564,2.2740849,'paris'],'paris-205459':[48.8487608,2.25744,'paris'],'paris-207299':[48.855456,2.261844,'paris'],'paris-218867':[48.8694727,2.2680949,'paris'],'paris-226147':[48.8569356,2.2265092,'paris'],'paris-226179':[48.8597974,2.2277911,'paris'],'paris-226563':[48.8550649,2.2260547,'paris']} :
      bucket == 4 ? {'13100409892':[51.7611271,-1.248962,'oxford'],'8224442660':[51.762307,-1.2578123,'oxford'],'paris-2000212':[48.8744313,2.2554889,'paris'],'paris-2000420':[48.8771155,2.2569317,'paris'],'paris-2002388':[48.8648243,2.2521679,'paris'],'paris-2009236':[48.8740822,2.259165,'paris'],'paris-214276':[48.8530039,2.2603521,'paris'],'paris-218740':[48.8690542,2.2676296,'paris'],'paris-226164':[48.8584163,2.227126,'paris'],'paris-235156':[48.8504558,2.2587148,'paris'],'paris-236164':[48.8496906,2.2581855,'paris'],'paris-236292':[48.8599761,2.264219,'paris']} :
      bucket == 5 ? {'13100409893':[51.7607262,-1.2496653,'oxford'],'3102635413':[51.7620885,-1.2514838,'oxford'],'9233073397':[51.7621345,-1.2527222,'oxford'],'paris-2000149':[48.8801769,2.2594432,'paris'],'paris-2002389':[48.8671184,2.2529421,'paris'],'paris-218581':[48.871075,2.2720795,'paris'],'paris-218725':[48.8704521,2.2701488,'paris'],'paris-226357':[48.8688753,2.2366658,'paris'],'paris-234309':[48.8778575,2.2780816,'paris']} :
      bucket == 6 ? {'3102635398':[51.7608917,-1.2502926,'oxford'],'8668770710':[51.7601844,-1.2577194,'oxford'],'8668823430':[51.7606963,-1.2584117,'oxford'],'9233073414':[51.7633883,-1.2526268,'oxford'],'paris-2002390':[48.8586731,2.2583394,'paris'],'paris-218742':[48.8687916,2.2670754,'paris'],'paris-226550':[48.853705,2.2261439,'paris'],'paris-234182':[48.8785369,2.2726491,'paris']} :
      bucket == 7 ? {'3102635383':[51.7598434,-1.2504589,'oxford'],'paris-2000263':[48.8757305,2.256224,'paris'],'paris-2000327':[48.8796885,2.2633818,'paris'],'paris-2002391':[48.8628933,2.2614606,'paris'],'paris-2045847':[48.8602028,2.2595095,'paris'],'paris-207303':[48.8526533,2.2600443,'paris'],'paris-226343':[48.8681541,2.2350196,'paris']} :
      bucket == 8 ? {'13100408200':[51.7610582,-1.2518081,'oxford'],'paris-2000616':[48.877597,2.2571804,'paris'],'paris-2002344':[48.8625497,2.2378984,'paris'],'paris-2002392':[48.8631108,2.2618006,'paris'],'paris-226184':[48.8604102,2.2281192,'paris'],'paris-226200':[48.8620472,2.2290123,'paris']} :
      bucket == 9 ? {'8668823433':[51.7639794,-1.2518654,'oxford'],'paris-2000233':[48.8749501,2.2558185,'paris'],'paris-2000345':[48.879387,2.2657878,'paris'],'paris-2000377':[48.8788541,2.2700641,'paris'],'paris-226169':[48.8588547,2.2273263,'paris'],'paris-234217':[48.8536429,2.2606824,'paris']} :
      bucket == 10 ? {'paris-2000362':[48.8791064,2.2680591,'paris'],'paris-2002346':[48.8692261,2.2460078,'paris'],'paris-2002394':[48.8648179,2.2526762,'paris'],'paris-207370':[48.8583679,2.2633949,'paris']} :
      bucket == 11 ? {'paris-2002347':[48.8632632,2.2407248,'paris'],'paris-2002395':[48.8639869,2.2513343,'paris'],'paris-204923':[48.8516618,2.2594054,'paris'],'paris-226155':[48.8576288,2.2267917,'paris']} :
      bucket == 12 ? {'paris-2000172':[48.8797879,2.2625807,'paris'],'paris-2000332':[48.8796058,2.2640448,'paris'],'paris-2000396':[48.8762188,2.2564684,'paris'],'paris-2002348':[48.8633907,2.2404811,'paris'],'paris-2009036':[48.8648104,2.233706,'paris'],'paris-218732':[48.8698569,2.2691101,'paris'],'paris-218748':[48.8710311,2.2711754,'paris']} :
      bucket == 13 ? {'9233073405':[51.7627473,-1.2536614,'oxford'],'paris-2000653':[48.878517,2.257651,'paris'],'paris-2002349':[48.8630096,2.2417738,'paris'],'paris-2002397':[48.8601786,2.2595003,'paris'],'paris-203837':[48.8490795,2.2580127,'paris'],'paris-226141':[48.8564025,2.2263284,'paris']} :
      bucket == 14 ? {'paris-2000350':[48.8793023,2.26646,'paris'],'paris-2000638':[48.8781141,2.2574462,'paris'],'paris-2002350':[48.8694583,2.2477134,'paris'],'paris-2002398':[48.8661272,2.2625479,'paris'],'paris-2023422':[48.8609412,2.2284035,'paris'],'paris-203214':[48.8610933,2.2651295,'paris'],'paris-203870':[48.8589985,2.2635929,'paris'],'paris-218718':[48.8544276,2.2260577,'paris'],'paris-226174':[48.8593705,2.22757,'paris'],'paris-228366':[48.856384,2.262524,'paris'],'paris-234158':[48.8605137,2.2647717,'paris']} :
      bucket == 15 ? {'13100409007':[51.7612961,-1.2508071,'oxford'],'9233073391':[51.763044,-1.2541406,'oxford'],'paris-2002351':[48.8702225,2.2481924,'paris'],'paris-218655':[48.8686153,2.236096,'paris'],'paris-226207':[48.8626389,2.229345,'paris'],'paris-234575':[48.8781177,2.2760139,'paris']} :
      {}; }
    function reservedTree(id) { return id in ['13100408200','paris-2000160','paris-2000332','paris-2002344','paris-2002347','paris-2002350','paris-2002387','paris-2002390','paris-2002392','paris-2002394','paris-2009036','paris-2023422','paris-204514','paris-235156','paris-236289','paris-236292']; }
    function parkBounds() { return {'oxford':[51.7594034,51.7652305,-1.2598572,-1.2476235,68899],'paris':[48.8480378,48.8803177,2.2252095,2.2791689,73232]}; }
    function weeklyScopes() { return {'paris--osm-31823720':'paris-2023422','paris--osm-86105117':'paris-2000332','paris--osm-1245281':'paris-2002387','paris--osm-264582480':'paris-2002344','paris--osm-86805803':'paris-235156','paris--osm-313851551':'paris-2009036','paris--osm-1164997':'paris-2002392','paris--osm-489240050':'paris-2002350','paris--osm-13792244':'paris-2002390','paris--g-1291-13724':'paris-236292','paris--g-1288-13725':'paris-2002347','paris--g-1292-13725':'paris-236289','paris--g-1290-13726':'paris-2002394','paris--g-1292-13727':'paris-204514','paris--g-1291-13729':'paris-2000160'}; }
    // END GENERATED PARK CATALOG
    function gameEntry(id) {
      let segments=id.split('-');
      return id.matches('([a-z0-9]+-)?[0-9]+')
        ? gameBucket(int(segments[segments.size()-1]) % 16).get(id,null) : null;
    }
    function playable(id) { return gameEntry(id) != null; }
    function nearGameTree(id,proof) {
      let registered = gameEntry(id);
      let dy = (proof.lat - registered[0]) * 111320;
      let dx = (proof.lng - registered[1]) * parkBounds()[registered[2]][4];
      return proof.park == registered[2] && dy * dy + dx * dx <= 441;
    }
    function validClaimLocation(location) {
      return location.keys().hasOnly(['treeId','park','lat','lng','at'])
        && location.treeId is string && location.park is string && location.lat is number && location.lng is number
        && location.at == request.time && playable(location.treeId) && nearGameTree(location.treeId,location);
    }
    function locationMatches(id) {
      let proof = getAfter(/databases/$(database)/documents/players/$(uid())/private/claimLocation).data;
      return proof.treeId == id && validClaimLocation(proof);
    }
    match /parksConfig/{id} {
      allow get: if signed() && id == 'live';
    }
    function testPlayer(id) { return get(player(id)).data.pseudo.matches('test-.*'); }
    function walletPath(id) { return /databases/$(database)/documents/players/$(id)/private/wallet; }
    function auctionPath(id) { return /databases/$(database)/documents/auctions/$(id); }
    function parkVisitPath(id,week) { return /databases/$(database)/documents/players/$(id)/visits/$(week); }
    function validParkVisit(key,p) {
      let bounds=parkBounds()[p.park];
      return p.keys().hasOnly(['park','lat','lng','week','at']) && p.park != 'oxford'
        && p.lat is number && p.lng is number && p.lat >= bounds[0] && p.lat <= bounds[1] && p.lng >= bounds[2] && p.lng <= bounds[3]
        && p.at == request.time && visitWeek(p.week) && key == p.park + '--park--' + string(p.week);
    }
    function validWallet(w) {
      return w.keys().hasAll(['credit','spent','key','held']) && w.keys().hasOnly(['credit','spent','key','held'])
        && w.credit is int && w.spent is int && w.held is int && w.key is string
        && w.credit >= w.spent + w.held && w.spent >= 0 && w.held >= 0
        && (w.held == 0 ? w.key == '' : w.key != '');
    }
    function lockBid(old,next) {
      let a = getAfter(auctionPath(next.key)).data;
      return old.held == 0 && next.held >= 30 && a.bidder == uid() && a.amount == next.held && millis() < a.close
        && (!exists(auctionPath(next.key)) || get(auctionPath(next.key)).data.bidder != uid());
    }
    function unlockBid(old,next) {
      let a = get(auctionPath(old.key)).data;
      return old.held > 0 && next.held == 0 &&
        ((a.bidder != uid() && a.amount > old.held && next.spent == old.spent)
          || (a.bidder == uid() && a.amount == old.held && millis() >= a.close && next.spent == old.spent + old.held));
    }
    function walletChanges(old,next) {
      return next.credit >= old.credit && next.spent >= old.spent &&
        ((next.key == old.key && next.held == old.held) ||
          (next.spent == old.spent && next.key != '' && lockBid(old,next)) ||
          (next.key == '' && unlockBid(old,next)));
    }
    function visitWeek(week) {
      return week is int && (week % 604800000 == 345600000 || week % 604800000 == 342000000)
        && millis() >= week && millis() < week + 608400000;
    }
    function validBid(key,a) {
      let isTest = key.matches('test-[0-9]+');
      let w = getAfter(walletPath(uid())).data;
      return a.keys().hasAll(['start','close','until','amount','bidder','clanId','visit'])
        && a.keys().hasOnly(['start','close','until','amount','bidder','clanId','visit'])
        && a.start is int && a.amount is int && a.amount >= 30 && a.visit is string
        && a.bidder == uid() && a.clanId == me().clanId && millis() >= a.start && millis() < a.close
        && (isTest
          ? testPlayer(uid()) && a.start % 240000 == 0 && key == 'test-' + string(a.start)
            && a.close == a.start + 120000 && a.until == a.start + 240000
          : !testPlayer(uid()) && key == string(a.start) && a.visit == key && a.start % 604800000 == 345600000
            && millis() >= seasonStartMillis() && a.close < seasonEndMillis()
            && a.close == a.start + 172800000 && a.until == a.start + 604800000)
        && visitWeek(get(parkVisitPath(uid(),a.visit)).data.week)
        && validWallet(w) && w.key == key && w.held == a.amount
        && (!exists(walletPath(uid())) || get(walletPath(uid())).data.held == 0);
    }
    function validScopedBid(key,a) {
      let visit = get(parkVisitPath(uid(),a.visit)).data;
      let w = getAfter(walletPath(uid())).data;
      let isTest = key.matches('test-.*');
      let park = a.scope.split('--')[0];
      return a.keys().hasOnly(['start','close','until','amount','bidder','clanId','visit','scope','treeId'])
        && a.scope in weeklyScopes() && weeklyScopes()[a.scope] == a.treeId && park == gameEntry(a.treeId)[2]
        && a.start is int && a.amount is int && a.amount >= 30
        && a.bidder == uid() && a.clanId == me().clanId && millis() >= a.start && millis() < a.close
        && (isTest
          ? testPlayer(uid()) && a.start % 240000 == 0 && key == 'test-' + a.scope + '--' + string(a.start)
            && a.close == a.start + 120000 && a.until == a.start + 240000
          : !testPlayer(uid()) && key == a.scope + '--' + string(a.start) && visit.week == a.start
            && a.start % 604800000 == 345600000 && millis() >= seasonStartMillis() && a.close < seasonEndMillis()
            && a.close == a.start + 172800000 && a.until == a.start + 604800000)
        && visit.park == park && visitWeek(visit.week)
        && validWallet(w) && w.key == key && w.held == a.amount
        && (!exists(walletPath(uid())) || get(walletPath(uid())).data.held == 0);
    }
    function auctionMatches(key,entry) {
      return 'scope' in entry ? validScopedBid(key,entry) : validBid(key,entry);
    }
    match /auctions/{key} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.amount == 30 && auctionMatches(key,request.resource.data);
      allow update: if signed() && resource.data.bidder != uid()
        && request.resource.data.amount == resource.data.amount + 5
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount','bidder','clanId','visit'])
        && auctionMatches(key,request.resource.data);
    }
    match /referrals/{invitee} {
      allow read: if signed() && (invitee == uid() || resource.data.inviter == uid());
      allow create: if signed() && invitee == uid() && request.resource.data.invitee == uid()
        && request.resource.data.keys().hasOnly(['inviter','invitee','at'])
        && request.resource.data.inviter is string && request.resource.data.inviter != uid()
        && testPlayer(uid()) == testPlayer(request.resource.data.inviter)
        && get(player(request.resource.data.inviter)).data.pseudo != ''
        && me().pseudo != '' && request.resource.data.at == request.time;
    }

    function playerFields(p) {
      return p.keys().hasOnly(['pseudo','nivel','xp','clanId','puntosTemporada','updatedAt','slots','leftUntil'])
        && p.pseudo is string && p.pseudo.size() <= 24 && (p.clanId == null || p.clanId is string)
        && p.nivel is int && p.nivel >= 1 && p.nivel <= 20 && p.xp is int && p.xp >= 0
        && p.xp >= 25 * p.nivel * (p.nivel - 1)
        && (p.nivel == 20 || p.xp < 25 * p.nivel * (p.nivel + 1))
        && p.puntosTemporada is int && p.puntosTemporada >= 0
        && p.slots is list && p.slots.size() <= 5
        && p.leftUntil is int;
    }
    function membershipChange(old, next) {
      return (old.clanId == next.clanId && old.leftUntil == next.leftUntil) ||
        (old.clanId == null && next.clanId is string && old.leftUntil <= millis() && next.leftUntil == old.leftUntil
          && next.nivel >= 5 && uid() in getAfter(clan(next.clanId)).data.members) ||
        (old.clanId is string && next.clanId == null && nearNow(next.leftUntil - 86400000)
          && !(uid() in getAfter(clan(old.clanId)).data.members));
    }
    match /players/{id} {
      allow read: if signed();
      allow create: if signed() && uid() == id && playerFields(request.resource.data)
        && request.resource.data.clanId == null && request.resource.data.leftUntil == 0
        && request.resource.data.slots.size() == 0;
      allow update: if signed() && uid() == id && playerFields(request.resource.data)
        && (resource.data.pseudo == '' || request.resource.data.pseudo == resource.data.pseudo)
        && resource.data.xp <= request.resource.data.xp && membershipChange(resource.data,request.resource.data);
      match /private/{file} {
        allow read: if signed() && uid() == id;
        allow create, update: if signed() && uid() == id && (file in ['save','membership'] || (file == 'receipts'
          && request.resource.data.items is list && request.resource.data.items.size() <= 40));
        allow create, update: if signed() && uid() == id && file == 'claimLocation' && validClaimLocation(request.resource.data);
        allow create: if signed() && uid() == id && file == 'wallet' && validWallet(request.resource.data) &&
          (request.resource.data.held == 0 || lockBid({'held':0},request.resource.data));
        allow update: if signed() && uid() == id && file == 'wallet' && validWallet(request.resource.data)
          && walletChanges(resource.data,request.resource.data);
      }
      match /visits/{week} {
        allow read: if signed() && uid() == id;
        allow create: if signed() && uid() == id && request.resource.data.keys().hasOnly(['week','at'])
          && week == string(request.resource.data.week) && visitWeek(request.resource.data.week) && request.resource.data.at == request.time;
        allow create: if signed() && uid() == id && validParkVisit(week,request.resource.data);
      }
      match /testGrants/{grant} {
        allow read, create: if signed() && uid() == id && testPlayer(uid())
          && (request.method != 'create' || (request.resource.data.keys().hasOnly(['kind','at'])
            && request.resource.data.kind in ['xp','savia'] && request.resource.data.at == request.time));
      }
    }
    match /admins/{id} {
      allow get: if signed() && uid() == id;
    }

    function validTree(t) {
      return t.keys().hasOnly(['ownerUid','ownerPseudo','clanId','tier','acquiredAt','protectedUntil','vitalityUntil','level','lastCareBy','lastCareAt','activeChallenge','ledger'])
        && t.ownerUid is string && t.ownerPseudo is string && (t.clanId == null || t.clanId is string)
        && t.tier in ['comun','notable','remarcable'] && t.level is int && t.level >= 1 && t.level <= 4
        && t.acquiredAt is int && (t.protectedUntil == t.acquiredAt + 3600000 || t.protectedUntil == t.acquiredAt) && t.vitalityUntil is int && t.ledger is map;
    }
    function freshClaim(id, next) {
      let p = getAfter(player(uid())).data;
      return playable(id) && !reservedTree(id) && locationMatches(id) && next.ownerUid == uid() && next.ownerPseudo == p.pseudo && next.clanId == p.clanId
        && id in p.slots && p.slots.size() <= (p.nivel < 5 ? 3 : (p.nivel < 10 ? 4 : 5))
        && nearNow(next.acquiredAt) && next.protectedUntil == next.acquiredAt + 3600000 && next.vitalityUntil == next.acquiredAt + 604800000
        && next.level == 1 && next.lastCareAt == null && next.lastCareBy == null && next.activeChallenge == null;
    }
    function opensDuel(id, old, next, change) {
      let d = getAfter(duel(next.activeChallenge)).data;
      return change.hasOnly(['activeChallenge','ledger']) && old.activeChallenge == null
        && next.activeChallenge is string && d.treeId == id && d.status == 'open'
        && d.attackerUid == uid() && d.defenderUid == old.ownerUid;
    }
    function resolvesDuel(id, old, next, change) {
      let d = get(duel(old.activeChallenge)).data;
      let after = getAfter(duel(old.activeChallenge)).data;
      return d.treeId == id && d.status == 'open' && next.activeChallenge == null &&
        ((after.status == 'defended' && guardedByMe(old.ownerUid) && change.hasOnly(['activeChallenge','ledger'])) ||
         (after.status == 'won' && millis() >= d.expiresAt && next.ownerUid == d.attackerUid
          && next.tier == old.tier && next.acquiredAt == d.expiresAt && next.vitalityUntil == d.expiresAt + 604800000
          && next.level == 1 && next.lastCareAt == null && next.lastCareBy == null
          && next.clanId == get(player(d.attackerUid)).data.clanId && next.ownerPseudo == get(player(d.attackerUid)).data.pseudo));
    }
    function changesTree(id, old, next) {
      let change = next.diff(old).affectedKeys();
      return
        ((seasonExpired(old.acquiredAt) || old.activeChallenge == null && millis() >= old.vitalityUntil + 259200000)
          && next.tier == old.tier && freshClaim(id,next)) ||
        (!seasonExpired(old.acquiredAt) && change.hasOnly(['protectedUntil']) &&
          next.protectedUntil == old.acquiredAt && testPlayer(uid()) && testPlayer(old.ownerUid)) ||
        (guardedByMe(old.ownerUid) && change.hasOnly(['lastCareBy','lastCareAt','vitalityUntil','ledger'])
          && next.lastCareBy == uid() && nearNow(next.lastCareAt) && next.lastCareAt != old.lastCareAt
          && millis() < old.vitalityUntil + 259200000 && next.vitalityUntil == next.lastCareAt + 604800000) ||
        (uid() == old.ownerUid && change.hasOnly(['level','clanId','ledger'])
          && next.level >= old.level && next.level <= old.level + 1
          && (next.clanId == old.clanId || next.clanId == getAfter(player(uid())).data.clanId)) ||
        (old.activeChallenge == null && next.activeChallenge is string && opensDuel(id,old,next,change)) ||
        (old.activeChallenge is string && next.activeChallenge == null && resolvesDuel(id,old,next,change));
    }
    match /trees/{id} {
      allow read: if signed();
      allow create: if signed() && !reservedTree(id) && validTree(request.resource.data) && freshClaim(id,request.resource.data)
        && request.resource.data.ledger.size() == 0;
      allow update: if signed() && id != weeklyTree() && validTree(request.resource.data) && changesTree(id,resource.data,request.resource.data);
    }
    match /challenges/{id} {
      allow read: if signed();
      allow create: if signed() && newDuel(id,request.resource.data);
      allow update: if signed() && (resolveState(id,resource.data,request.resource.data) ||
        (resource.data.status == 'open' && millis() < resource.data.expiresAt
          && uid() in [resource.data.attackerUid,resource.data.defenderUid]
          && testPlayer(resource.data.attackerUid) && testPlayer(resource.data.defenderUid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt'])
          && request.resource.data.expiresAt < resource.data.expiresAt
          && request.resource.data.expiresAt >= millis() + 45000 && request.resource.data.expiresAt <= millis() + 75000));
    }
    function newDuel(id,d) {
      let t = get(tree(d.treeId)).data;
      let other = get(player(d.defenderUid)).data;
      let p = getAfter(player(uid())).data;
      return d.keys().hasOnly(['treeId','attackerUid','defenderUid','price','createdAt','expiresAt','status'])
        && playable(d.treeId) && !reservedTree(d.treeId) && locationMatches(d.treeId) && !seasonExpired(t.acquiredAt)
        && d.status == 'open' && d.attackerUid == uid() && uid() != d.defenderUid && t.ownerUid == d.defenderUid
        && d.price is int && d.price >= 10 && nearNow(d.createdAt) && d.expiresAt == d.createdAt + 900000
        && t.protectedUntil <= millis() && millis() < t.vitalityUntil + 259200000
        && (p.clanId == null || p.clanId != other.clanId)
        && d.treeId in p.slots && p.slots.size() <= (p.nivel < 5 ? 3 : (p.nivel < 10 ? 4 : 5))
        && t.activeChallenge == null && getAfter(tree(d.treeId)).data.activeChallenge == id;
    }
    function resolveState(id,old,next) {
      let change = next.diff(old).affectedKeys();
      let after = getAfter(tree(old.treeId)).data;
      return old.status == 'open' && !seasonExpired(old.createdAt) && next.resolvedAt == request.time
        && get(tree(old.treeId)).data.activeChallenge == id && after.activeChallenge == null &&
        ((next.status == 'defended' && millis() < old.expiresAt && change.hasOnly(['status','resolvedAt','defendedBy'])
          && next.defendedBy == uid() && guardedByMe(old.defenderUid) && after.ownerUid == old.defenderUid) ||
         (next.status == 'won' && millis() >= old.expiresAt && change.hasOnly(['status','resolvedAt'])
          && after.ownerUid == old.attackerUid));
    }

    function clanFields(c) {
      return c.name is string && c.name.size() >= 3 && c.name.size() <= 20
        && c.emblem in ['🌳','🍃','🌿','🍄','🦉','🦊','🐝','🌻']
        && c.color in ['#42745a','#397aa5','#915b58','#6b5894','#986621','#397d77']
        && c.open is bool && c.archived is bool && c.members is map
        && c.memberCount == c.members.size() && c.memberCount <= 15
        && c.points is int && c.points >= 0 && c.weekGoal == 40
        && c.weekProgress is int && c.weekProgress >= 0 && c.weekProgress <= 40
        && c.weekKey is string && c.weekKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }
    function correctCode(id) {
      let proof = getAfter(/databases/$(database)/documents/players/$(uid())/private/membership).data;
      return proof.clanId == id && get(codeRef(proof.code)).data.clanId == id;
    }
    function joinsClan(id,old,next,change) {
      return change.hasOnly(['members','memberCount'])
        && !old.archived && old.memberCount < 15 && next.memberCount == old.memberCount + 1
        && !(uid() in old.members) && uid() in next.members && nearNow(next.members[uid()])
        && next.members.diff(old.members).affectedKeys().hasOnly([uid()])
        && me().clanId == null && me().nivel >= 5 && me().leftUntil <= millis()
        && getAfter(player(uid())).data.clanId == id && (old.open || correctCode(id));
    }
    function leavesClan(id,old,next,change) {
      return change.hasOnly(['members','memberCount','ownerUid','archived','open']) && member(id)
        && uid() in old.members && !(uid() in next.members) && next.members.diff(old.members).affectedKeys().hasOnly([uid()])
        && next.memberCount == old.memberCount - 1 && getAfter(player(uid())).data.clanId == null
        && (next.memberCount == 0
          ? next.archived && !next.open && next.ownerUid == null
          : !next.archived && next.open == old.open &&
            (old.ownerUid == uid() ? next.ownerUid in next.members : next.ownerUid == old.ownerUid));
    }
    function caredForClan(old,next) {
      let before = get(tree(next.lastCareTree)).data;
      let after = getAfter(tree(next.lastCareTree)).data;
      return next.lastCareTree.matches('[0-9]+') && after.lastCareBy == uid() && nearNow(after.lastCareAt) && before.lastCareAt != after.lastCareAt
        && next.weekKey >= old.weekKey
        && (next.weekKey == old.weekKey
          ? next.weekProgress == (old.weekProgress == 40 ? 40 : old.weekProgress + 1)
          : next.weekProgress == 1);
    }
    match /clans/{id} {
      allow read: if signed();
      allow create: if signed() && clanFields(request.resource.data) &&
        request.resource.data.ownerUid == uid() && request.resource.data.createdAt == request.time
        && request.resource.data.memberCount == 1 && uid() in request.resource.data.members
        && nearNow(request.resource.data.members[uid()]) && !request.resource.data.archived
        && request.resource.data.points == 0 && request.resource.data.weekProgress == 0 && me().clanId == null
        && me().nivel >= 5 && me().leftUntil <= millis() && getAfter(player(uid())).data.clanId == id;
      allow update: if signed() && clanFields(request.resource.data)
        && updateClan(id,resource.data,request.resource.data);

      match /private/{id2} {
        allow read: if member(id);
        allow create: if signed() && id2 == 'code' && getAfter(clan(id)).data.ownerUid == uid()
          && request.resource.data.code.matches('[A-Z]{6}')
          && getAfter(codeRef(request.resource.data.code)).data.clanId == id;
      }
      match /notices/{note} {
        allow read: if member(id);
        allow create: if signed() && request.resource.data.uid == uid() && request.resource.data.at == request.time
          && request.resource.data.reactions.size() == 0 && request.resource.data.pseudo == me().pseudo
          && ((request.resource.data.type in ['clan_creado','clan_unido'] && getAfter(player(uid())).data.clanId == id)
            || (request.resource.data.type in ['clan_salido','cuidar','defender'] && member(id)));
        allow update: if member(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([uid()])
          && (!(uid() in request.resource.data.reactions) || request.resource.data.reactions[uid()] in [0,1,2,3]);
      }
    }
    function validWeekName(week) {
      let parts = week.split('-');
      return week.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && visitWeek(timestamp.date(int(parts[0]),int(parts[1]),int(parts[2])).toMillis());
    }
    function scopedCare(old,next) {
      let key = next.activeParkGoal;
      let record = next.parkGoals[key];
      let oldGoals = old.get('parkGoals',{});
      let earlier = oldGoals.get(key,{'progress':0});
      let treeId = record.lastCareTree;
      let before = get(tree(treeId)).data;
      let after = getAfter(tree(treeId)).data;
      return next.parkGoals.diff(oldGoals).affectedKeys().hasOnly([key])
        && record.keys().hasOnly(['park','week','progress','lastCareTree'])
        && record.park != 'oxford' && record.park in parkBounds() && key == record.park + '-' + record.week && validWeekName(record.week)
        && playable(treeId) && gameEntry(treeId)[2] == record.park && !reservedTree(treeId)
        && record.progress == (earlier.progress >= 40 ? 40 : earlier.progress + 1)
        && after.lastCareBy == uid() && nearNow(after.lastCareAt) && before.lastCareAt != after.lastCareAt;
    }
    function updateClan(id,old,next) {
      let change = next.diff(old).affectedKeys();
      return joinsClan(id,old,next,change) || leavesClan(id,old,next,change) ||
        (!old.archived && member(id) &&
         ((change.hasOnly(['points']) && next.points >= old.points)
           || (change.hasOnly(['weekKey','weekProgress','lastCareTree']) && caredForClan(old,next))
           || (change.hasOnly(['parkGoals','activeParkGoal']) && scopedCare(old,next))));
    }
    match /clanCodes/{code} {
      allow get: if signed();
      allow create: if signed() && code.matches('[A-Z]{6}')
        && getAfter(clan(request.resource.data.clanId)).data.ownerUid == uid()
        && getAfter(/databases/$(database)/documents/clans/$(request.resource.data.clanId)/private/code).data.code == code;
    }
    match /clanGoals/{id} {
      allow read: if signed() && uid() in resource.data.eligible;
      allow create: if signed() && ('park' in request.resource.data ? validScopedGoal(id,request.resource.data) : validGoal(id,request.resource.data));
    }
    function validScopedGoal(id,g) {
      let old=get(clan(g.clanId)).data;
      let next=getAfter(clan(g.clanId)).data;
      let key=g.park + '-' + g.week;
      return member(g.clanId) && g.keys().hasOnly(['clanId','week','eligible','at','park']) && g.park != 'oxford' && g.park in parkBounds()
        && id == g.clanId + '_' + g.week + '_' + g.park && g.at == request.time
        && old.get('parkGoals',{}).get(key,{'progress':0}).progress == 39 && next.parkGoals[key].progress == 40
        && g.eligible is list && g.eligible.toSet() == next.members.keys().toSet();
    }
    function validGoal(id,g) {
      let before = get(clan(g.clanId)).data;
      let after = getAfter(clan(g.clanId)).data;
      return member(g.clanId) && id == g.clanId + '_' + g.week && g.at == request.time
        && g.week == after.weekKey && after.weekProgress == 40 && before.weekProgress == 39
        && g.eligible is list && g.eligible.toSet() == after.members.keys().toSet();
    }
    match /events/{id} {
      allow read: if signed() && (resource.data.uid == uid() || admin());
      allow create: if signed() && request.resource.data.uid == uid() && request.resource.data.tipo is string;
      allow update: if signed() && resource.data.uid == uid() && resource.data.tipo == 'actividad_diaria'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['juego_ms','parque_ms','metros']);
    }
  }
}
