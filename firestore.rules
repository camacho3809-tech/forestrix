    function weeklyScopes() { return {'paris--plaine-bagatelle':'paris-grove-1012538562018','paris--grande-cascade':'paris-2002348','paris--lac-inferieur':'paris-2002391','paris--lac-superieur':'paris-2002390','paris--mare-saint-james':'paris-2002387','paris--croix-catelan':'paris-2002394','paris--porte-boulogne':'paris-218718','paris--pelouse-madrid':'paris-osm-2165129720'}; }
